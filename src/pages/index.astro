---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <div class="hero-content">
        <div class="hero-text">
          <h1>Lexing Daily Life</h1>
          <p>
            Software engineer, writer, and coach helping developers build better
            careers and healthier lives.
          </p>
        </div>
        <a href="/about" aria-label="About Martin Cartledge">
          <img src="/me.png" alt="Martin Cartledge" class="hero-image" />
        </a>
      </div>
    </section>

    <Hr />

    <section id="writing-cta" class="cta-card">
      <h2>Read My Thoughts</h2>
      <p>
        What I'm learning about Go, distributed systems, and AI, plus career
        advice and running.
      </p>
      <LinkButton href="/posts">Browse All Posts →</LinkButton>
    </section>

    <Hr />

    <section id="coaching-cta" class="cta-card">
      <h2>Level Up Your Tech Career</h2>
      <p>
        Ten years in software and a mentor to engineers and students along the
        way. I can help with interview prep, resumes, and the step up to senior.
      </p>
      <LinkButton href="/coaching">Explore Career Coaching →</LinkButton>
    </section>

    <Hr />

    <section id="run-coaching-cta" class="cta-card">
      <h2>Escape the Chair</h2>
      <p>
        I spent years stuck at a desk and in my own head. Running helped me more
        than anything else. I'll help you fit it around a real job.
      </p>
      <LinkButton href="/run-coaching">Explore Run Coaching →</LinkButton>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  /* ===== Hero Section ===== */
  #hero {
    @apply pt-12 pb-8;
  }
  .hero-content {
    @apply flex flex-col-reverse items-center gap-8 sm:flex-row sm:justify-between;
  }
  .hero-text {
    @apply flex-1;
  }
  #hero h1 {
    @apply mb-4 inline-block text-4xl leading-tight font-bold tracking-tight sm:text-5xl;
  }
  #hero p {
    @apply mt-4 text-lg leading-relaxed opacity-70;
  }
  .hero-image {
    @apply h-32 w-32 rounded-full border-2 border-skin-accent object-cover sm:h-40 sm:w-40;
  }

  /* ===== CTA Cards ===== */
  .cta-card {
    @apply pt-16 pb-10;
  }
  .cta-card h2 {
    @apply mb-4 text-3xl leading-tight font-bold tracking-tight;
  }
  .cta-card p {
    @apply mb-6 text-base leading-relaxed opacity-60;
  }
</style>
