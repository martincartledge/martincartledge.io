---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <div class="hero-content">
        <div class="hero-text">
          <h1>Lexing Daily Life</h1>
          <p>
            Software engineer, writer, and coach helping developers build better
            careers and healthier lives.
          </p>
        </div>
        <img src="/me.png" alt="Martin Cartledge" class="hero-image" />
      </div>
    </section>

    <Hr />

    <section id="writing-cta" class="cta-card">
      <h2>Read My Thoughts</h2>
      <p>
        Deep dives into compilers, interpreters, API design, and the craft of
        software engineering.
      </p>
      <LinkButton href="/posts">Browse All Posts →</LinkButton>
    </section>

    <Hr />

    <section id="coaching-cta" class="cta-card">
      <h2>Level Up Your Tech Career</h2>
      <p>
        10 years of engineering experience. Proven mentorship track record.
        Navigate your career journey—from interview prep to senior-level
        transitions.
      </p>
      <LinkButton href="/coaching">Explore Career Coaching →</LinkButton>
    </section>

    <Hr />

    <section id="run-coaching-cta" class="cta-card">
      <h2>Escape the Chair</h2>
      <p>
        Desk-bound? Mental fog? I've been there. Running transformed my health
        as a developer— better focus, less stress, more energy.
      </p>
      <LinkButton href="/run-coaching">Explore Run Coaching →</LinkButton>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply pb-8 pt-12;
  }
  .hero-content {
    @apply flex flex-col-reverse items-center gap-8 sm:flex-row sm:justify-between;
  }
  .hero-text {
    @apply flex-1;
  }
  #hero h1 {
    @apply mb-4 inline-block text-4xl font-bold leading-tight tracking-tight sm:text-5xl;
  }
  #hero p {
    @apply mt-4 text-lg leading-relaxed opacity-70;
  }
  .hero-image {
    @apply h-32 w-32 rounded-full border-2 border-skin-accent object-cover sm:h-40 sm:w-40;
  }

  /* ===== CTA Cards ===== */
  .cta-card {
    @apply pb-10 pt-16;
  }
  .cta-card h2 {
    @apply mb-4 text-3xl font-bold leading-tight tracking-tight;
  }
  .cta-card p {
    @apply mb-6 text-base leading-relaxed opacity-60;
  }
</style>
